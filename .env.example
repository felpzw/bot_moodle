# UFSC CAS credentials used to sign in to Moodle (required).
MOODLE_USER=your_username
MOODLE_PASS=your_password

# PostgreSQL connection string; the default matches docker-compose.yml.
# DATABASE_URL=postgresql://bot_user:bot_password@localhost:5432/moodle_queue

# Optional AI replies: set both the API key and a valid conversation ID.
# TEST_CONVERSATION_ID enables the reader despite its TEST_ prefix.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# TEST_CONVERSATION_ID=your_conversation_id

# Optional seed: inserts a message on EVERY startup when a conversation is set.
# Leave TEST_CONTENT unset for normal operation. TEST_USER_ID defaults to 0.
# TEST_USER_ID=your_moodle_user_id
# TEST_CONTENT=Hello from the Moodle messaging bot.

# Console logging verbosity (default: INFO).
# LOG_LEVEL=INFO
